# Copy to .env and adjust. Do NOT commit .env.
ENVIRONMENT=development

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://asclepius:asclepius@localhost:5432/asclepius

# Redis (queue / streaming, used in later phases)
REDIS_URL=redis://localhost:6379/0

# Comma/JSON list of allowed browser origins for the frontend
CORS_ORIGINS=["http://localhost:3000"]
